{
  "name": "Clinic Receptionist — Main (WhatsApp AI Agent)",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "wa-trigger",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [0, 300],
      "webhookId": "clinic-wa-webhook",
      "credentials": {
        "whatsAppTriggerApi": { "id": "REPLACE", "name": "WhatsApp OAuth" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "from",
              "value": "={{ $json.messages[0].from }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "text",
              "value": "={{ $json.messages[0].text.body }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "name",
              "value": "={{ $json.contacts[0].profile.name }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract",
      "name": "Extract Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "استبدل هذا النص بمحتوى ملف system-prompt-ar.md بعد تعبئة بيانات العيادة."
        }
      },
      "id": "agent",
      "name": "Receptionist Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [480, 300]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-20250514",
        "options": { "temperature": 0.3 }
      },
      "id": "llm",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [360, 520],
      "credentials": {
        "anthropicApi": { "id": "REPLACE", "name": "Anthropic account" }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Extract Message').item.json.from }}",
        "contextWindowLength": 20
      },
      "id": "memory",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [500, 520]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "calendar_get_availability — يرجع الفترات الفارغة. مرّر البريد/التقويم للطبيب المطلوب ونطاق التاريخ.",
        "operation": "getAll",
        "calendar": { "__rl": true, "value": "REPLACE_CALENDAR_ID", "mode": "id" },
        "returnAll": false,
        "limit": 20,
        "options": {
          "timeMin": "={{ $fromAI('timeMin', 'ISO start of search window') }}",
          "timeMax": "={{ $fromAI('timeMax', 'ISO end of search window') }}"
        }
      },
      "id": "cal-avail",
      "name": "calendar_get_availability",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [640, 520],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "REPLACE", "name": "Google Calendar" }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "calendar_create_event — يثبّت الحجز. لا تستدعِه قبل موافقة المريض على وقت محدد ووجود اسم ثلاثي.",
        "operation": "create",
        "calendar": { "__rl": true, "value": "REPLACE_CALENDAR_ID", "mode": "id" },
        "start": "={{ $fromAI('start', 'ISO datetime of appointment start') }}",
        "end": "={{ $fromAI('end', 'ISO datetime of appointment end') }}",
        "additionalFields": {
          "summary": "={{ $fromAI('summary', 'مثال: موعد أسنان — منصور القحطاني') }}",
          "description": "={{ $fromAI('description', 'رقم الجوال + التخصص + ملاحظات') }}"
        }
      },
      "id": "cal-create",
      "name": "calendar_create_event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [780, 520],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "REPLACE", "name": "Google Calendar" }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "calendar_cancel_event — يلغي موعدًا قائمًا عبر معرّف الحدث.",
        "operation": "delete",
        "calendar": { "__rl": true, "value": "REPLACE_CALENDAR_ID", "mode": "id" },
        "eventId": "={{ $fromAI('eventId', 'Google Calendar event id to cancel') }}"
      },
      "id": "cal-cancel",
      "name": "calendar_cancel_event",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [920, 520],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "REPLACE", "name": "Google Calendar" }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "sheets_find_patient — يبحث عن مريض برقم الجوال في ورقة Patients.",
        "operation": "lookup",
        "documentId": { "__rl": true, "value": "REPLACE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Patients", "mode": "name" },
        "lookupColumn": "phone",
        "lookupValue": "={{ $fromAI('phone', 'patient whatsapp number') }}"
      },
      "id": "sheet-find",
      "name": "sheets_find_patient",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.5,
      "position": [1060, 520],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE", "name": "Google Sheets" }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "sheets_add_patient — يسجّل مريضًا جديدًا في ورقة Patients.",
        "operation": "append",
        "documentId": { "__rl": true, "value": "REPLACE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Patients", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "phone": "={{ $fromAI('phone') }}",
            "full_name": "={{ $fromAI('full_name', 'الاسم الرباعي') }}",
            "national_id": "={{ $fromAI('national_id') }}",
            "birth_year": "={{ $fromAI('birth_year') }}",
            "insurance": "={{ $fromAI('insurance') }}",
            "created_at": "={{ $now.toISO() }}"
          }
        }
      },
      "id": "sheet-add",
      "name": "sheets_add_patient",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.5,
      "position": [1200, 520],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE", "name": "Google Sheets" }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "sheets_add_waitlist — يضيف المريض لقائمة الانتظار في ورقة Waitlist عند عدم توفر موعد قريب.",
        "operation": "append",
        "documentId": { "__rl": true, "value": "REPLACE_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Waitlist", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "phone": "={{ $fromAI('phone') }}",
            "full_name": "={{ $fromAI('full_name') }}",
            "specialty": "={{ $fromAI('specialty', 'التخصص أو الطبيب المطلوب') }}",
            "requested_range": "={{ $fromAI('requested_range', 'الفترة التي يريدها المريض') }}",
            "status": "waiting",
            "created_at": "={{ $now.toISO() }}"
          }
        }
      },
      "id": "sheet-wait",
      "name": "sheets_add_waitlist",
      "type": "n8n-nodes-base.googleSheetsTool",
      "typeVersion": 4.5,
      "position": [1340, 520],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE", "name": "Google Sheets" }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "handoff_to_staff — يحوّل المحادثة لموظف بشري بإرسال تنبيه للعيادة. استخدمه للفوترة والشكاوى والطوارئ وأي طلب خارج نطاقك.",
        "sendTo": "REPLACE_STAFF_EMAIL",
        "subject": "=تحويل محادثة واتساب — {{ $fromAI('reason', 'سبب التحويل') }}",
        "message": "=رقم المريض: {{ $('Extract Message').item.json.from }}\nالاسم: {{ $('Extract Message').item.json.name }}\nالسبب: {{ $fromAI('reason') }}\nملخص: {{ $fromAI('summary', 'ملخص الطلب حتى الآن') }}",
        "options": {}
      },
      "id": "handoff",
      "name": "handoff_to_staff",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [1480, 520],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE", "name": "Gmail (staff)" }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "REPLACE_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Extract Message').item.json.from }}",
        "textBody": "={{ $json.output }}",
        "additionalFields": {}
      },
      "id": "wa-send",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [760, 300],
      "credentials": {
        "whatsAppApi": { "id": "REPLACE", "name": "WhatsApp API" }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": { "main": [[{ "node": "Extract Message", "type": "main", "index": 0 }]] },
    "Extract Message": { "main": [[{ "node": "Receptionist Agent", "type": "main", "index": 0 }]] },
    "Receptionist Agent": { "main": [[{ "node": "Send WhatsApp Reply", "type": "main", "index": 0 }]] },
    "Anthropic Chat Model": { "ai_languageModel": [[{ "node": "Receptionist Agent", "type": "ai_languageModel", "index": 0 }]] },
    "Conversation Memory": { "ai_memory": [[{ "node": "Receptionist Agent", "type": "ai_memory", "index": 0 }]] },
    "calendar_get_availability": { "ai_tool": [[{ "node": "Receptionist Agent", "type": "ai_tool", "index": 0 }]] },
    "calendar_create_event": { "ai_tool": [[{ "node": "Receptionist Agent", "type": "ai_tool", "index": 0 }]] },
    "calendar_cancel_event": { "ai_tool": [[{ "node": "Receptionist Agent", "type": "ai_tool", "index": 0 }]] },
    "sheets_find_patient": { "ai_tool": [[{ "node": "Receptionist Agent", "type": "ai_tool", "index": 0 }]] },
    "sheets_add_patient": { "ai_tool": [[{ "node": "Receptionist Agent", "type": "ai_tool", "index": 0 }]] },
    "sheets_add_waitlist": { "ai_tool": [[{ "node": "Receptionist Agent", "type": "ai_tool", "index": 0 }]] },
    "handoff_to_staff": { "ai_tool": [[{ "node": "Receptionist Agent", "type": "ai_tool", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
